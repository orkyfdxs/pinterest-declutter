{
  "manifest_version": 3,
  "name": "Pinterest Declutter",
  "version": "1.5.2",
  "description": "Strips Pinterest down to the home feed and your boards. Hides ads, shopping, suggestions and extra nav.",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.pinterest.com/*",
    "*://pinterest.com/*",
    "*://*.pinterest.co.uk/*",
    "*://*.pinterest.ca/*",
    "*://*.pinterest.com.au/*",
    "*://*.pinterest.de/*",
    "*://*.pinterest.fr/*",
    "*://*.pinterest.es/*",
    "*://*.pinterest.it/*",
    "*://*.pinterest.nz/*",
    "*://*.pinterest.ph/*",
    "*://*.pinterest.jp/*",
    "*://*.pinterest.com.mx/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pinterest Declutter",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.pinterest.com/*",
        "*://pinterest.com/*",
        "*://*.pinterest.co.uk/*",
        "*://*.pinterest.ca/*",
        "*://*.pinterest.com.au/*",
        "*://*.pinterest.de/*",
        "*://*.pinterest.fr/*",
        "*://*.pinterest.es/*",
        "*://*.pinterest.it/*",
        "*://*.pinterest.nz/*",
        "*://*.pinterest.ph/*",
        "*://*.pinterest.jp/*",
        "*://*.pinterest.com.mx/*"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
